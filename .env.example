# Copy to .env and fill in. Never commit .env.
MISTRAL_API_KEY=

# "mistral" for the real model, "mock" for the deterministic offline model
RECON_LLM=mistral
RECON_MODEL=mistral-small-latest

# Agent limits
RECON_MAX_STEPS=8
RECON_REQUEST_TIMEOUT_S=60
RECON_LLM_TIMEOUT_S=30

# USD per 1M tokens. Check https://mistral.ai/pricing before quoting cost numbers.
RECON_PRICE_IN_PER_M=0.10
RECON_PRICE_OUT_PER_M=0.30

# Simulated model latency for the mock model (ms)
RECON_MOCK_LATENCY_MS=0
